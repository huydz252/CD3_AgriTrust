<!DOCTYPE html>
<html lang="vi">
<head>
    <%- include('../partials/head') %>
    <title>Truy xuất nguồn gốc - #<%= product.id %></title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
</head>

<body class="bg-light">
    <%- include('../partials/header') %>
    <div id="mySidebar" class="sidebar">
        <div class="sidebar-header">
            <h3 class="text-white">AgriTrust</h3>
            <a href="javascript:void(0)" class="closebtn" id="closeSidebar">&times;</a>
        </div>
        <div class="sidebar-content">
            <a href="/"><i class="bi bi-house-door"></i> Trang chủ</a>
            <a href="/user/cart"><i class="bi bi-cart"></i> Giỏ hàng</a>
            <a href="/user/cart/purchased_product"><i class="bi bi-truck"></i> Sản phẩm đang mua</a>
            <a href="/user/cart/history"><i class="bi bi-bag-check"></i> Sản phẩm đã mua</a>
            <hr class="text-secondary mx-3">
            <a href="/user/cart/statistics"><i class="bi bi-graph-up"></i> Thống kê</a>
            <a href="/user/profile"><i class="bi bi-person-circle"></i> Profile</a>
        </div>
    </div>
    <div id="sidebarOverlay" class="sidebar-overlay"></div>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                
                <div class="card main-card mb-4 bg-white shadow-sm">
                    <div class="row g-0">
                        <div class="col-md-5">
                            <img src="<%= product.image %>" class="product-header-img" alt="<%= product.name %>" onerror="this.src='/images/system/default.jpg'">
                        </div>
                        <div class="col-md-7">
                            <div class="card-body p-4 p-lg-5">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h1 class="fw-bold text-success mb-1"><%= product.name %></h1>
                                        <p class="text-muted">Mã định danh: <span class="badge bg-dark">#<%= product.id %></span></p>
                                    </div>
                                    <div class="qr-card text-center shadow-sm no-print">
                                        <img src="<%= qrCode %>" alt="QR Code" style="width: 110px; height: 110px;">
                                        <div style="font-size: 9px;" class="text-muted mt-2 fw-bold text-uppercase">QUÉT XÁC THỰC</div>
                                    </div>
                                </div>
                                
                                <hr class="my-4 opacity-25">
                                <p class="text-secondary mb-4 fst-italic"><%= product.fullDescription %></p>

                                <div class="row g-4 mb-4 text-center text-md-start">
                                    <div class="product-info-grid mb-4">
                                    <div class="d-flex justify-content-between align-items-end mb-3">
                                        <div style="max-width: 60%;">
                                            <label class="text-muted text-uppercase small fw-bold d-block mb-1">Nguồn gốc</label>
                                            <div class="text-dark fw-bold text-truncate">
                                                <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                                                <span title="<%= product.origin %>"><%= product.origin %></span>
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <label class="text-muted text-uppercase small fw-bold d-block mb-1">Trạng thái</label>
                                            <span class="badge <%= getStatusClass(product.currentStatus) %> px-3 py-2 rounded-pill shadow-sm">
                                                <%= getStatusName(product.currentStatus) %>
                                            </span>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-between align-items-end">
                                        <div>
                                            <label class="text-muted text-uppercase small fw-bold d-block mb-1">Giá niêm yết</label>
                                            <div class="text-primary fw-bold fs-5">
                                                <%= Number(product.price).toLocaleString('vi-VN') %> <small class="fs-6 fw-normal">VNĐ</small>
                                            </div>
                                        </div>
                                        <div class="text-end">
                                            <label class="text-muted text-uppercase small fw-bold d-block mb-1">Tồn kho</label>
                                            <div class="d-inline-flex align-items-center bg-light border rounded-pill px-3 py-1 shadow-sm">
                                                <i class="bi bi-box-seam me-2 text-success"></i>
                                                <span class="fw-bold me-1">
                                                    <%= typeof product.stock === 'number' ? product.stock.toFixed(1) : product.stock %>
                                                </span>
                                                <small class="text-muted">Kg</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <form>
                                    <input type="hidden" name="productId" value="<%= product.id %>">
                                    <div class="d-grid gap-2 btn-add-to-cart" style="padding: 10px 0;">
                                        <% if (user) { %>
                                            <% if (product.currentStatus == 3) { %> 
                                                <button type="button" onclick="addToCart('<%= product.id %>')" class="btn btn-success rounded-pill py-2 d-flex align-items-center justify-content-center gap-2 shadow-sm">
                                                    <i class="bi bi-cart-plus-fill"></i>  
                                                    Thêm vào giỏ hàng
                                                </button>
                                            <% } else { %>
                                                <button type="button" disabled 
                                                        class="btn btn-secondary rounded-pill py-2 d-flex align-items-center justify-content-center gap-2 shadow-sm w-100">
                                                    <i class="bi bi-dash-circle-fill"></i>   
                                                    <%= product.currentStatus == 4 ? 'Đã hết hàng' : 'Chưa mở bán' %>
                                                </button>
                                            <% }%>
                                        <% } else { %>
                                            <a href="/auth/google" class="btn btn-outline-secondary rounded-pill py-2">
                                                <i class="bi bi-google me-2"></i> Đăng nhập để mua
                                            </a>
                                        <% } %>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <% if (user) { %>
                    <% if (user.role === 'admin' || product.owner_address.toLowerCase() === user.wallet_address.toLowerCase()) { %>
                        <div class="text-center mb-4 no-print">
                            <button class="btn btn-primary rounded-pill px-5 py-2 shadow-sm fw-bold" data-bs-toggle="modal" data-bs-target="#modalUpdate">
                                <i class="bi bi-plus-circle-fill me-2"></i> Cập nhật giai đoạn mới
                            </button>
                        </div>
                    <% } %> 
                <% } %> 
                <div class="card main-card p-4 p-lg-5 bg-white shadow-sm">
                    <h4 class="fw-bold mb-5 text-dark d-flex align-items-center">
                        <i class="bi bi-shield-check-fill text-success fs-2 me-3"></i> 
                        Lịch sử hành trình Blockchain
                    </h4>

                    <button class="btn btn-outline-success rounded-pill px-4 shadow-sm fw-bold" 
                        data-bs-toggle="modal" 
                        data-bs-target="#modalMap"
                        onclick="initMap()"> <i class="bi bi-map-fill me-2"></i> Xem bản đồ hành trình
                    </button>
                    
                    <div class="timeline">
                        <% if (list && list.length > 0) { %>
                            <% list.forEach(function(item) { %>
                                <div class="timeline-item">
                                    <div class="timeline-dot shadow-sm"></div>
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h5 class="fw-bold text-dark mb-0"><%= getStatusName(item.status) %></h5>
                                            <div class="small text-primary mt-1"><i class="bi bi-geo-alt-fill"></i> <%= item.location %></div>
                                        </div>
                                        <span class="badge bg-light text-muted border px-3"><%= item.timestamp %></span>
                                    </div>
                                    
                                    <div class="description-box shadow-sm mb-3">
                                        <i class="bi bi-info-circle-fill text-success me-2"></i> 
                                        <span class="text-dark"><%= item.description %></span>
                                    </div>

                                    <div class="small text-muted">
                                        <i class="bi bi-person-check-fill"></i> Ký xác thực bởi:
                                        <code class="text-primary"><%= item.performer %></code>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-slash-circle fs-1"></i>
                                <p class="mt-2">Chưa có dữ liệu lịch sử được ghi nhận trên chuỗi.</p>
                            </div>
                        <% } %>
                    </div>
                </div>

                <div class="text-center mt-5 no-print">
                    <a href="/api/products" class="btn btn-outline-secondary rounded-pill px-4 me-2">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                    <button class="btn btn-dark rounded-pill px-4" onclick="window.print()">
                        <i class="bi bi-printer"></i> In báo cáo xác thực
                    </button>
                </div>
            </div> 
        </div>
    </div>


    <!-- modal updateStage -->
    <div class="modal fade" id="modalUpdate" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                <div class="modal-header bg-success text-white border-0 py-4">
                    <h5 class="modal-title fw-bold"><i class="bi bi-node-plus-fill me-2"></i> Ký xác nhận Giai đoạn mới</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" name="id" value="<%= product.id %>">
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">TRẠNG THÁI TIẾP THEO</label>
                        <select name="status" class="form-select rounded-pill shadow-sm border-success">
                            <option value="1">🧺 Đã thu hoạch</option>
                            <option value="2">🚚 Đang vận chuyển</option>
                            <option value="3">📦 Sẵn sàng bán</option>
                            <option value="4">❌ Đã hết hàng</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">ĐỊA ĐIỂM HIỆN TẠI</label>
                        <input type="text" name="location" class="form-control rounded-pill shadow-sm" placeholder="VD: Cửa hàng VinMart, Đà Nẵng" required> 
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">VĨ ĐỘ (LATITUDE)</label>
                            <input type="text" name="lat" class="form-control rounded-pill shadow-sm border-primary-subtle" placeholder="16.0544" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">KINH ĐỘ (LONGITUDE)</label>
                            <input type="text" name="lng" class="form-control rounded-pill shadow-sm border-primary-subtle" placeholder="108.2022" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-muted">GHI CHÚ CHI TIẾT</label>
                        <textarea name="description" class="form-control shadow-sm" rows="3" style="border-radius: 15px;" placeholder="Ví dụ: Kiểm tra chất lượng và nhập kho chi nhánh..." required></textarea>
                    </div>

                    <div class="alert alert-info py-2 mb-0" style="border-radius: 12px; font-size: 0.85rem;">
                        <i class="bi bi-info-circle-fill me-1"></i> 
                        Tọa độ này sẽ dùng để vẽ mốc tiếp theo trên bản đồ hành trình.
                    </div>
                </div>
                <div class="modal-footer border-0 pb-4 justify-content-center">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" id="btnConfirmUpdate" class="btn btn-success rounded-pill px-5 shadow fw-bold" onclick="updateStageOnChain()">
                        <i class="bi bi-pen-fill me-2"></i> KÝ & CẬP NHẬT
                    </button>
                </div>
            </div>
        </div>
    </div>


    <% 
    function getStatusName(status) {
        const statuses = ["Đang trồng", "Đã thu hoạch", "Đang vận chuyển", "Sẵn sàng bán", "Đã bán"];
        return statuses[status] || "Không xác định";
    }
    function getStatusClass(status) {
        const classes = ["bg-info text-dark", "bg-warning text-dark", "bg-primary text-white", "bg-success text-white", "bg-dark text-white"];
        return classes[status] || "bg-secondary";
    }
    %>

    <div class="modal fade" id="modalMap" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                <div class="modal-header border-0 pb-0">
                    <h5 class="fw-bold text-success"><i class="bi bi-geo-alt-fill me-2"></i>Bản đồ hành trình thực tế</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-3">
                    <div id="map" style="height: 500px; width: 100%; border-radius: 15px;"></div>
                    <div class="mt-3 text-center">
                        <p class="small text-muted mb-0">
                            <i class="bi bi-info-circle me-1"></i> 
                            Dữ liệu tọa độ được truy xuất và xác thực trực tiếp từ mạng Blockchain.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        window.PRODUCT_HISTORY_DATA = <%- JSON.stringify(list) %>;
    </script>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/ethers/6.7.0/ethers.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/sidebar.js"></script> </body>
    <script src="/js/web3-handler.js"></script>
    <script src="/js/updateCart.js"></script>
    <script src="/js/productHistory.js"></script>
</body>
</html>