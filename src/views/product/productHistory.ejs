<!DOCTYPE html>
<html lang="vi">
<head>
    <%- include('../partials/head') %>
    <title>Truy xuất nguồn gốc - #<%= product.id %></title>
</head>
<body class="bg-light">
    <%- include('../partials/header') %>
    <div id="mySidebar" class="sidebar">
        <div class="sidebar-header">
            <h3 class="text-white">AgriTrust</h3>
            <a href="javascript:void(0)" class="closebtn" id="closeSidebar">&times;</a>
        </div>
        <div class="sidebar-content">
            <a href="/"><i class="bi bi-house-door"></i> Trang chủ</a>
            <a href="/user/cart"><i class="bi bi-cart"></i> Giỏ hàng</a>
            <a href="/user/cart/purchased_product"><i class="bi bi-truck"></i> Sản phẩm đang mua</a>
            <a href="/user/cart/history"><i class="bi bi-bag-check"></i> Sản phẩm đã mua</a>
            <hr class="text-secondary mx-3">
            <a href="/user/cart/statistics"><i class="bi bi-graph-up"></i> Thống kê</a>
            <a href="/user/profile"><i class="bi bi-person-circle"></i> Profile</a>
        </div>
    </div>
    <div id="sidebarOverlay" class="sidebar-overlay"></div>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-9">
                
                <div class="card main-card mb-4 bg-white shadow-sm">
                    <div class="row g-0">
                        <div class="col-md-5">
                            <img src="<%= product.image %>" class="product-header-img" alt="<%= product.name %>" onerror="this.src='/images/system/default.jpg'">
                        </div>
                        <div class="col-md-7">
                            <div class="card-body p-4 p-lg-5">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h1 class="fw-bold text-success mb-1"><%= product.name %></h1>
                                        <p class="text-muted">Mã định danh: <span class="badge bg-dark">#<%= product.id %></span></p>
                                    </div>
                                    <div class="qr-card text-center shadow-sm no-print">
                                        <img src="<%= qrCode %>" alt="QR Code" style="width: 110px; height: 110px;">
                                        <div style="font-size: 9px;" class="text-muted mt-2 fw-bold text-uppercase">QUÉT XÁC THỰC</div>
                                    </div>
                                </div>
                                
                                <hr class="my-4 opacity-25">
                                <p class="text-secondary mb-4 fst-italic"><%= product.fullDescription %></p>

                                <div class="row g-3">
                                    <div class="col-6 col-md-4">
                                        <small class="text-muted d-block text-uppercase small fw-bold">Nguồn gốc</small>
                                        <div class="fw-bold"><i class="bi bi-geo-alt-fill text-danger"></i> <%= product.origin %></div>
                                    </div>
                                    <div class="col-6 col-md-4">
                                        <small class="text-muted d-block text-uppercase small fw-bold">Trạng thái</small>
                                        <span class="badge <%= getStatusClass(product.currentStatus) %> px-3 py-2 rounded-pill shadow-sm mt-1">
                                            <%= getStatusName(product.currentStatus) %>
                                        </span>
                                    </div>
                                    <div class="col-12 col-md-4">
                                        <small class="text-muted d-block text-uppercase small fw-bold">Giá niêm yết</small>
                                        <div class="fw-bold text-primary fs-5"><%= Number(product.price).toLocaleString('vi-VN') %> VNĐ</div>
                                    </div>
                                    <form action="/user/cart/add" method="POST">
                                        <input type="hidden" name="productId" value="<%= product.id %>">
                                        <div class="d-grid gap-2 btn-add-to-cart" style="padding: 10px 0;">
                                            <% if (user) { %>
                                                <button class="btn btn-outline-success rounded-pill d-flex align-items-center justify-content-center gap-2"
                                                onclick="alert('Đã thêm vào giỏ hàng!')">
                                                    <i class="bi bi-cart-plus"></i> 
                                                    Thêm vào giỏ
                                                </button>
                                            <% } else { %>
                                                <a href="/auth/google" class="btn btn-outline-secondary rounded-pill">
                                                    Đăng nhập để mua
                                                </a>
                                            <% } %>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <% if (user && user.role === 'admin') { %>
                    <div class="text-center mb-4 no-print">
                        <button class="btn btn-primary rounded-pill px-5 py-2 shadow-sm fw-bold" data-bs-toggle="modal" data-bs-target="#modalUpdate">
                            <i class="bi bi-plus-circle-fill me-2"></i> Cập nhật giai đoạn mới
                        </button>
                    </div>
                <% } %> 
                
                <div class="card main-card p-4 p-lg-5 bg-white shadow-sm">
                    <h4 class="fw-bold mb-5 text-dark d-flex align-items-center">
                        <i class="bi bi-shield-check-fill text-success fs-2 me-3"></i> 
                        Lịch sử hành trình Blockchain
                    </h4>
                    
                    <div class="timeline">
                        <% if (list && list.length > 0) { %>
                            <% list.forEach(function(item) { %>
                                <div class="timeline-item">
                                    <div class="timeline-dot shadow-sm"></div>
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h5 class="fw-bold text-dark mb-0"><%= getStatusName(item.status) %></h5>
                                            <div class="small text-primary mt-1"><i class="bi bi-geo-alt-fill"></i> <%= item.location %></div>
                                        </div>
                                        <span class="badge bg-light text-muted border px-3"><%= item.timestamp %></span>
                                    </div>
                                    
                                    <div class="description-box shadow-sm mb-3">
                                        <i class="bi bi-info-circle-fill text-success me-2"></i> 
                                        <span class="text-dark"><%= item.description %></span>
                                    </div>

                                    <div class="small text-muted">
                                        <i class="bi bi-person-check-fill"></i> Ký xác thực bởi:
                                        <code class="text-primary"><%= item.performer %></code>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="text-center py-5 text-muted">
                                <i class="bi bi-slash-circle fs-1"></i>
                                <p class="mt-2">Chưa có dữ liệu lịch sử được ghi nhận trên chuỗi.</p>
                            </div>
                        <% } %>
                    </div>
                </div>

                <div class="text-center mt-5 no-print">
                    <a href="/api/products" class="btn btn-outline-secondary rounded-pill px-4 me-2">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>
                    <button class="btn btn-dark rounded-pill px-4" onclick="window.print()">
                        <i class="bi bi-printer"></i> In báo cáo xác thực
                    </button>
                </div>
            </div> 
        </div>
    </div>

    <div class="modal fade" id="modalUpdate" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                <div class="modal-header bg-success text-white border-0 py-4">
                    <h5 class="modal-title fw-bold"><i class="bi bi-node-plus-fill me-2"></i> Ký xác nhận Giai đoạn mới</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <input type="hidden" name="id" value="<%= product.id %>">
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Trạng thái tiếp theo</label>
                        <select name="status" class="form-select rounded-pill shadow-sm">
                            <option value="1">🧺 Đã thu hoạch</option>
                            <option value="2">🚚 Đang vận chuyển</option>
                            <option value="3">📦 Sẵn sàng bán (Kho)</option>
                            <option value="4">✅ Đã bán lẻ</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Vị trí cập nhật</label>
                        <input type="text" name="location" class="form-control rounded-pill shadow-sm" placeholder="VD: Kho trung chuyển Gia Lai" required> 
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Ghi chú nhật ký</label>
                        <textarea name="description" class="form-control shadow-sm" rows="3" style="border-radius: 15px;" placeholder="Mô tả chi tiết hoạt động..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pb-4 justify-content-center">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" id="btnConfirmUpdate" class="btn btn-success rounded-pill px-5 shadow" onclick="updateStageOnChain()">
                        <i class="bi bi-pen-fill me-2"></i> Ký tên & Xác nhận
                    </button>
                </div>
            </div>
        </div>
    </div>

    <input type="hidden" id="adminAddr" value="<%= adminAddress %>">

    <% 
    function getStatusName(status) {
        const statuses = ["Đang trồng", "Đã thu hoạch", "Đang vận chuyển", "Sẵn sàng bán", "Đã bán"];
        return statuses[status] || "Không xác định";
    }
    function getStatusClass(status) {
        const classes = ["bg-info text-dark", "bg-warning text-dark", "bg-primary text-white", "bg-success text-white", "bg-dark text-white"];
        return classes[status] || "bg-secondary";
    }
    %>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/ethers/6.7.0/ethers.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/sidebar.js"></script> </body>
    <script src="/js/web3-handler.js"></script>
</body>
</html>