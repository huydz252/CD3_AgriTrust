<!DOCTYPE html>
<html lang="vi">
<head>
    <%- include('../partials/head') %> 
    <title>AgriTrust - Danh sách sản phẩm</title>
</head>
<body class="bg-light">
    <%- include('../partials/header') %>

    <div id="mySidebar" class="sidebar">
        <div class="sidebar-header">
            <h3 class="text-white">AgriTrust</h3>
            <a href="javascript:void(0)" class="closebtn" id="closeSidebar">&times;</a>
        </div>
        <div class="sidebar-content">
            <a href="/" class="active"><i class="bi bi-house-door"></i> Trang chủ</a>
            <a href="/user/cart"><i class="bi bi-cart"></i> Giỏ hàng</a>
            <a href="/user/cart/purchased_product"><i class="bi bi-truck"></i> Sản phẩm đang mua</a>
            <a href="/user/cart/history"><i class="bi bi-bag-check"></i> Sản phẩm đã mua</a>
            <hr class="text-secondary mx-3">
            <a href="/user/cart/statistics"><i class="bi bi-graph-up"></i> Thống kê</a>
            <a href="/user/profile"><i class="bi bi-person-circle"></i> Profile</a>
        </div>
    </div>
    <div id="sidebarOverlay" class="sidebar-overlay"></div>

    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-dark">Sản phẩm đang quản lý</h2>
            <span class="badge bg-dark text-white p-2 px-3"><%= list.length %> Sản phẩm</span>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            <% list.forEach(p => { %>
            <div class="col">
                <div class="card product-card h-100 shadow-sm position-relative">
                    <span class="badge badge-status <%= getStatusClass(p.currentStatus) %> shadow-sm">
                        <%= getStatusName(p.currentStatus) %>
                    </span>

                    <img src="<%= p.image %>" class="card-img-top product-img" alt="<%= p.name %>" onerror="this.onerror=null; this.src='/images/system/default.jpg';">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h4 class="card-title fw-bold mb-0 text-truncate" style="max-width: 70%;"><%= p.name %></h4>
                            <span class="text-muted small">#<%= p.id %></span>
                        </div>
                        
                        <p class="text-muted mb-3" style="display: -webkit-box;
                                                                    -webkit-line-clamp: 1; /* Giới hạn đúng 1 dòng */
                                                                    -webkit-box-orient: vertical;
                                                                    overflow: hidden;
                                                                    text-overflow: ellipsis;
                                                                    height: 1.5em; /* Cố định chiều cao để card luôn bằng nhau */">
                            <i class="bi bi-geo-alt-fill text-danger"></i> 
                            <%= p.origin %>
                        </p>
                        
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="price-tag text-danger fw-bold fs-5">
                                    <%= typeof p.price === 'number' ? p.price.toLocaleString('vi-VN') : p.price %> 
                                    <small class="fs-6 text-uppercase">VNĐ</small>
                                </div>

                                <div class="stock-tag badge rounded-pill bg-light text-dark border shadow-sm px-3 py-2">
                                    <i class="bi bi-box-seam me-1 text-success"></i>
                                    <span class="fw-bold">
                                        <%= typeof p.stock === 'number' ? p.stock.toFixed(1) : p.stock %>
                                    </span>
                                    <small class="text-muted">Kg</small>
                                </div>
                            </div>

                        <p class="card-text text-secondary mb-4" style="display: -webkit-box;
                                                                        -webkit-line-clamp: 1; /* Giới hạn đúng 1 dòng */
                                                                        -webkit-box-orient: vertical;
                                                                        overflow: hidden;
                                                                        text-overflow: ellipsis;
                                                                        height: 1.5em; /* Cố định chiều cao để card luôn bằng nhau */">
                        <%= p.description && p.description !== "Không tìm thấy mô tả sản phẩm" ? p.description : "Chưa có mô tả chi tiết." %>
                        </p>

                        <div class="d-grid">
                            <a href="/api/history/<%= p.id %>" class="btn btn-trace fw-bold py-2">
                                <i class="bi bi-shield-check-fill me-2"></i> Truy xuất nguồn gốc
                            </a>
                            <form>
                            <input type="hidden" name="productId" value="<%= p.id %>">
                            <div class="d-grid gap-2 btn-add-to-cart" style="padding: 10px 0;">
                                <% if (user) { %>
                                    <% if (p.currentStatus == 3) { %>
                                        <button type="button" onclick="addToCart('<%= p.id %>')" class="btn btn-outline-success rounded-pill d-flex align-items-center justify-content-center gap-2">
                                            <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                                        </button>
                                    <% } else{ %>
                                        <button type="button" disabled onclick="addToCart('<%= p.id %>')" 
                                                        class="btn btn-secondary rounded-pill py-2 d-flex align-items-center justify-content-center gap-2 shadow-sm w-100">
                                            <i class="bi bi-cart-plus"></i> 
                                            <%= p.currentStatus == 4 ? 'Đã hết hàng' : 'Chưa mở bán' %> 
                                        </button>
                                    <% } %>
                                <% } else { %>
                                    <a href="/auth/google" class="btn btn-outline-secondary rounded-pill">
                                        Đăng nhập để mua
                                    </a>
                                <% } %>
                            </div>
                        </form>
                        </div>
                    </div>
                </div>
            </div>
            <% }) %>
        </div>
    </div>
    

    <!-- modal thêm sản phẩm -->
    <% if (user && user.role === 'admin') { %>
        <button class="btn btn-success add-btn border-0" data-bs-toggle="modal" data-bs-target="#modalCreate">
            <i class="bi bi-plus-lg"></i>
        </button>
    <% } %>

    <div class="modal fade" id="modalCreate" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                <div class="modal-header border-0 pb-0">
                    <h4 class="fw-bold text-success">Thêm nông sản mới</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form action="/api/createProduct" method="POST" id="formCreateProduct">
                    <div class="modal-body p-4">
                        <div class="row g-4">
                            <div class="col-md-6 border-end">
                                <h6 class="text-muted mb-3 fw-bold small uppercase">Dữ liệu định danh</h6>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold small">Mã ID (Blockchain)</label>
                                        <input type="number" name="id" class="form-control rounded-pill bg-light" placeholder="Ví dụ: 101" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold small">Giá bán (VNĐ)</label>
                                        <input type="number" name="price" class="form-control rounded-pill bg-light" placeholder="55000" required>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label fw-bold small">Tên sản phẩm</label>
                                        <input type="text" name="name" class="form-control rounded-pill" placeholder="Táo Gia Lai..." required>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label fw-bold small">Link hình ảnh</label>
                                        <input type="text" name="image_url" class="form-control rounded-pill" placeholder="/images/products/taogialai.jpg">
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label fw-bold small">Mô tả chi tiết</label>
                                        <textarea name="description" class="form-control" rows="4" style="border-radius: 15px;" placeholder="Quy trình trồng..."></textarea>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <h6 class="text-muted mb-3 fw-bold small uppercase">Vị trí & Trạng thái</h6>
                                <div class="row g-3">
                                    <div class="col-12">
                                        <label class="form-label fw-bold small">Nguồn gốc (Địa điểm)</label>
                                        <input type="text" name="origin" class="form-control rounded-pill" placeholder="Vườn sạch A, Gia Lai">
                                    </div>
                                    
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold small text-primary"><i class="bi bi-geo-alt"></i> Vĩ độ (Lat)</label>
                                        <input type="text" name="lat" class="form-control rounded-pill border-primary" placeholder="15.5673" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-bold small text-primary"><i class="bi bi-geo-alt"></i> Kinh độ (Lng)</label>
                                        <input type="text" name="lng" class="form-control rounded-pill border-primary" placeholder="108.4821" required>
                                    </div>

                                    <div class="col-12 mt-4">
                                        <label class="form-label fw-bold small text-success">Trạng thái khởi tạo</label>
                                        <select name="status" class="form-select rounded-pill border-success shadow-sm" required>
                                            <option value="0" selected>🌱 Đang trồng / Nuôi dưỡng</option>
                                            <option value="1">🧺 Đã thu hoạch</option>
                                            <option value="2">🚚 Đang vận chuyển</option>
                                            <option value="3">📦 Sẵn sàng bán</option>
                                            <option value="4">🚫 Đã hết hàng</option>
                                        </select>
                                        <div class="form-text small text-muted mt-2">Dữ liệu này sẽ được ghi trực tiếp vào Blockchain để truy xuất nguồn gốc.</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0 pb-4 justify-content-center">
                        <button type="button" class="btn btn-light rounded-pill px-5 mx-2" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-success rounded-pill px-5 mx-2 shadow-sm" id="btnSubmit">
                            <i class="bi bi-cpu"></i> Ký & Lưu hệ thống
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <% 
    function getStatusName(status) {
        const statuses = ["Đang trồng", "Đã thu hoạch", "Đang vận chuyển", "Sẵn sàng bán", "Đã bán hết"];
        return statuses[status] || "Không xác định";
    }

    function getStatusClass(status) {
        const classes = ["bg-info text-dark", "bg-warning text-dark", "bg-primary text-white", "bg-success text-white", "bg-dark text-white"];
        return classes[status] || "bg-secondary";
    }
    %>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script> 
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/sidebar.js"></script> 
    <script src="/js/updateCart.js"></script>
    <script src="/js/productList.js"></script>
    <script>
        const form = document.getElementById('formCreateProduct');
        const btn = document.getElementById('btnSubmit');
        form.addEventListener('submit', () => {
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang ký Blockchain...';
            btn.disabled = true;
        });
    </script>

</body>
</html>