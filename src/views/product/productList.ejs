<!DOCTYPE html>
<html lang="vi">
<head>
    <%- include('../partials/head') %> 
    <title>AgriTrust - Danh sách sản phẩm</title>
</head>
<body>
    <nav class="navbar navbar-dark py-3 mb-5">
        <div class="container d-flex justify-content-between">
            <a class="navbar-brand fw-bold fs-3" href="#">
                <i class="bi bi-leaf-fill"></i> AgriTrust
            </a>
            <div class="text-white d-none d-md-block">
                <small class="opacity-75">Admin Wallet:</small>
                <code class="text-warning fw-bold"><%= adminAddress.substring(0,6) %>...<%= adminAddress.substring(38) %></code>
            </div>
            <!-- login -->
            <div class="ms-auto" class="auth-container">
                <% if (typeof user !== 'undefined' && user) { %>
                    <div class="dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" data-bs-toggle="dropdown">
                            <img src="<%= user.avatar_url %>" class="rounded-circle me-2" style="width: 32px; height: 32px;" onerror="this.src='/images/system/default-user.jpg'">
                            <span class="fw-bold"><%= user.display_name %></span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                            <li><a class="dropdown-item" href="/user/profile"><i class="bi bi-person me-2"></i> Hồ sơ</a></li>
                            <li><a class="dropdown-item" href="/user/cart"><i class="bi bi-cart me-2"></i> Giỏ hàng</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="/auth/logout"><i class="bi bi-box-arrow-right me-2"></i> Đăng xuất</a></li>
                        </ul>
                    </div>
                <% } else { %>
                    <a href="/auth/google" class="btn btn-outline-dark rounded-pill px-4 fw-bold shadow-sm">
                        <img src="/images/system/default-user.jpg" class="me-2 user-avatar">
                        Đăng nhập Google
                    </a>
                <% } %>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold text-dark">Sản phẩm đang quản lý</h2>
            <span class="badge bg-dark text-white p-2 px-3"><%= list.length %> Sản phẩm</span>
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            <% list.forEach(p => { %>
            <div class="col">
                <div class="card product-card h-100 shadow-sm position-relative">
                    <span class="badge badge-status <%= getStatusClass(p.status) %> shadow-sm">
                        <%= getStatusName(p.status) %>
                    </span>

                    <img src="<%= p.image %>" class="card-img-top product-img" alt="<%= p.name %>" onerror="this.onerror=null; this.src='/images/system/default.jpg';">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h4 class="card-title fw-bold mb-0 text-truncate" style="max-width: 70%;"><%= p.name %></h4>
                            <span class="text-muted small">#<%= p.id %></span>
                        </div>
                        
                        <p class="text-muted mb-3" style="display: -webkit-box;
                                                                        -webkit-line-clamp: 1; /* Giới hạn đúng 1 dòng */
                                                                        -webkit-box-orient: vertical;
                                                                        overflow: hidden;
                                                                        text-overflow: ellipsis;
                                                                        height: 1.5em; /* Cố định chiều cao để card luôn bằng nhau */">
                            <i class="bi bi-geo-alt-fill text-danger"></i> 
                            <%= p.origin %>
                        </p>
                        
                        <div class="price-tag mb-3">
                            <%= typeof p.price === 'number' ? p.price.toLocaleString('vi-VN') : p.price %> <small>VNĐ</small>
                        </div>

                        <p class="card-text text-secondary mb-4" style="display: -webkit-box;
                                                                        -webkit-line-clamp: 1; /* Giới hạn đúng 1 dòng */
                                                                        -webkit-box-orient: vertical;
                                                                        overflow: hidden;
                                                                        text-overflow: ellipsis;
                                                                        height: 1.5em; /* Cố định chiều cao để card luôn bằng nhau */">
                        <%= p.description && p.description !== "Không tìm thấy mô tả sản phẩm" ? p.description : "Chưa có mô tả chi tiết." %>
                        </p>

                        <div class="d-grid">
                            <a href="/api/history/<%= p.id %>" class="btn btn-trace fw-bold py-2">
                                <i class="bi bi-shield-check-fill me-2"></i> Truy xuất nguồn gốc
                            </a>
                            <form action="/user/cart/add" method="POST">
                            <input type="hidden" name="productId" value="<%= p.id %>">
                            <div class="d-grid gap-2 btn-add-to-cart" style="padding: 10px 0;">
                                <% if (user) { %>
                                    <button type="submit" class="btn btn-outline-success rounded-pill d-flex align-items-center justify-content-center gap-2">
                                        <i class="bi bi-cart-plus"></i> Thêm vào giỏ
                                    </button>
                                <% } else { %>
                                    <a href="/auth/google" class="btn btn-outline-secondary rounded-pill">
                                        Đăng nhập để mua
                                    </a>
                                <% } %>
                            </div>
                        </form>
                        </div>
                    </div>
                </div>
            </div>
            <% }) %>
        </div>
    </div>

    <button class="btn btn-success add-btn border-0" data-bs-toggle="modal" data-bs-target="#modalCreate">
        <i class="bi bi-plus-lg"></i>
    </button>

    <div class="modal fade" id="modalCreate" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 20px;">
                <div class="modal-header border-0 pb-0">
                    <h4 class="fw-bold text-success">Thêm nông sản mới</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form action="/api/createProduct" method="POST" id="formCreateProduct">
                    <div class="modal-body p-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Mã ID (Blockchain)</label>
                                <input type="number" name="id" class="form-control rounded-pill" placeholder="Ví dụ: 101" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small">Giá bán (VNĐ)</label>
                                <input type="number" name="price" class="form-control rounded-pill" placeholder="55000" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold small">Tên sản phẩm</label>
                                <input type="text" name="name" class="form-control rounded-pill" placeholder="Táo Gia Lai..." required>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold small">Nguồn gốc</label>
                                <input type="text" name="origin" class="form-control rounded-pill" placeholder="Vườn sạch A, Gia Lai">
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold small text-success">Trạng thái khởi tạo</label>
                                <select name="status" class="form-select rounded-pill border-success shadow-sm" required>
                                    <option value="0" selected>🌱 Đang trồng / Nuôi dưỡng</option>
                                    <option value="1">🧺 Đã thu hoạch</option>
                                    <option value="2">🚚 Đang vận chuyển</option>
                                    <option value="3">📦 Sẵn sàng bán (Trong kho)</option>
                                    <option value="4">✅ Đã bán lẻ</option>
                                </select>
                                <div class="form-text small">Sản phẩm sẽ bắt đầu lịch sử tại giai đoạn này.</div>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold small">Link hình ảnh</label>
                                <input type="text" name="image_url" class="form-control rounded-pill" placeholder="/images/products/taogialai.jpg">
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-bold small">Mô tả chi tiết</label>
                                <textarea name="description" class="form-control" rows="3" style="border-radius: 15px;" placeholder="Thông tin về quy trình trồng..."></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-success rounded-pill px-4" id="btnSubmit">Ký & Lưu hệ thống</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <% 
    function getStatusName(status) {
        const statuses = ["Đang trồng", "Đã thu hoạch", "Đang vận chuyển", "Sẵn sàng bán", "Đã bán"];
        return statuses[status] || "Không xác định";
    }

    function getStatusClass(status) {
        const classes = ["bg-info text-dark", "bg-warning text-dark", "bg-primary text-white", "bg-success text-white", "bg-dark text-white"];
        return classes[status] || "bg-secondary";
    }
    %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const form = document.getElementById('formCreateProduct');
        const btn = document.getElementById('btnSubmit');
        form.addEventListener('submit', () => {
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang ký Blockchain...';
            btn.disabled = true;
        });
    </script>
</body>
</html>