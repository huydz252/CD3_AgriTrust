<!DOCTYPE html>
<html lang="vi">
<head>
    <%- include('../partials/head') %>
    <style>
        .history-card { border-radius: 15px; border: none; transition: 0.3s; }
        .history-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.1); }
        .product-thumb { width: 60px; height: 60px; object-fit: cover; border-radius: 10px; }
    </style>
</head>
<body class="bg-light">
    <%- include('../partials/header') %>


    <div class="container py-5" id="main">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold mb-0"><i class="bi bi-clock-history me-2 text-success"></i>Lịch sử mua hàng</h2>
            <span class="badge bg-success rounded-pill px-3 py-2">Đã hoàn thành</span>
        </div>

        <% if (orders && orders.length > 0) { %>
            <div class="row">
                <% orders.forEach(order => { %>
                    <div class="col-12 mb-4">
                        <div class="card history-card shadow-sm">
                            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="text-muted small">Mã đơn hàng:</span>
                                    <span class="fw-bold text-primary">#<%= order.order_code %></span>
                                </div>
                                <span class="text-muted small">
                                    Ngày hoàn thành: <%= new Date(order.updated_at || order.created_at).toLocaleDateString('vi-VN') %>
                                </span>
                            </div>
                            <div class="card-body border-top">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-box-seam fs-3 text-secondary me-3"></i>
                                        <div>
                                            <p class="mb-0 fw-bold">Tổng cộng: <%= Number(order.total_amount).toLocaleString('vi-VN') %>đ</p>
                                            <p class="mb-0 small text-muted">Hình thức: <%= order.payment_method %></p>
                                        </div>
                                    </div>
                                    <a href="/user/cart/order_detail/<%= order.id %>" class="btn btn-outline-success btn-sm rounded-pill px-4">
                                        Xem chi tiết
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-5">
                <i class="bi bi-journal-x display-1 text-muted"></i>
                <p class="mt-3 fs-5 text-muted">Bạn chưa có đơn hàng nào hoàn thành.</p>
                <a href="/" class="btn btn-success rounded-pill px-5 shadow">Tiếp tục mua sắm</a>
            </div>
        <% } %>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ui/sidebar.js"></script>  
</body>
</html>