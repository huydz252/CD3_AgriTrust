<!DOCTYPE html>
<html lang="vi">
<head>
    <%- include('../partials/head') %>
    <title>Giỏ hàng | AgriTrust</title>
    <style>
        .cart-item-img { width: 80px; height: 80px; object-fit: cover; border-radius: 12px; }
        .quantity-control { max-width: 120px; }
    </style>
</head>
<body class="bg-light">
    <%- include('../partials/header') %>

    <div class="container py-5">
        <h2 class="fw-bold mb-4"><i class="bi bi-cart3 me-2"></i>Giỏ hàng của bạn</h2>
        
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 p-3">
                    <% if (cartItems && cartItems.length > 0) { %>
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr class="text-muted small">
                                        <th>Sản phẩm</th>
                                        <th>Giá (1 kg)</th>
                                        <th>Số lượng (kg)</th>
                                        <th>Tổng</th>
                                        <th>Xóa</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% cartItems.forEach(item => { %>
                                        <tr class="cart-item" data-cart_id = "<%= item.id %>" data-product_id = "<%=item.product_id%>">
                                            <input type="hidden" id="stock" value="<%= item.stock %>">
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <img src="<%= item.image_url %>" class="cart-item-img me-3">
                                                    <div>
                                                        <h6 class="mb-0 fw-bold"><%= item.product_name %></h6>
                                                        <small class="text-muted"><%= item.name %></small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="unit-price" data-value="<%= item.price %>"><%= (item.price * 1).toLocaleString('vi-VN') %>đ</td>
                                            <td>
                                                <div class="input-group input-group-sm quantity-control">
                                                    <button class="btn btn-outline-secondary btn-minus">-</button>
                                                    <input type="number" 
                                                        class="form-control text-center input-qty" 
                                                        value="<%= item.quantity %>" 
                                                        min="0.2" 
                                                        step="0.1"
                                                        readonly>
                                                    <button class="btn btn-outline-secondary btn-plus">+</button>
                                                </div>
                                            </td>
                                            <td class="total-item-price fw-bold text-success"><%= (item.price * item.quantity).toLocaleString('vi-VN') %>đ</td>
                                            <td>
                                                <button class="btn btn-delete btn-link text-danger">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="text-center py-5">
                            <img src="https://cdn-icons-png.flaticon.com/512/11329/11329060.png" style="width: 100px; opacity: 0.5;">
                            <p class="mt-3 text-muted">Giỏ hàng của bạn đang trống rỗng.</p>
                            <a href="/api/products" class="btn btn-success rounded-pill px-4">Tiếp tục mua sắm</a>
                        </div>
                    <% } %>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 20px;">
                    <h5 class="fw-bold mb-4">Tổng cộng</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tạm tính:</span>
                        <span id="temp-total">0đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3 border-bottom pb-3">
                        <span>Phí vận chuyển:</span>
                        <span class="text-success" id="ship-fee">Miễn phí</span>
                    </div>
                    <div id="min-order-msg" class="alert alert-warning small d-none">
                        <i class="bi bi-exclamation-triangle"></i> Đơn hàng tối thiểu từ 50.000đ (Chưa tính phí ship) để thanh toán.
                    </div>
                    <div class="d-flex justify-content-between mb-4">
                        <span class="fs-5 fw-bold">Tổng tiền:</span>
                        <span class="fs-5 fw-bold text-success" id="final-total">0đ</span>
                    </div>
                    <button id="btn-checkout-qr" class="btn btn-dark w-100 rounded-pill py-2 mb-2 fw-bold">THANH TOÁN BẰNG QR</button>
                    <button id="btn-checkout-cod" class="btn btn-dark w-100 rounded-pill py-2 mb-2 fw-bold">THANH TOÁN COD</button>
                    <button id="btn-checkout-metamask" class="btn btn-outline-primary w-100 rounded-pill py-2 d-flex align-items-center justify-content-center gap-2">
                        <img src="/images/system/metamask_icon.jpg" style="width: 20px;">
                        THANH TOÁN METAMASK
                    </button>
                </div>
            </div>
        </div>

        <!-- modal checkout-qr -->
         <div class="modal fade" id="qrModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4 border-0">
                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold">Quét mã QR để thanh toán</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body text-center pb-4">
                        <img id="qrImage" src="" alt="VietQR" class="img-fluid rounded-3 mb-3 shadow-sm" style="max-width: 300px;">
                        <p class="mb-1 text-muted">Số tiền: <strong id="qrAmount">0đ</strong></p>
                        <p class="small text-danger">Nội dung: <strong id="qrDesc"></strong></p>
                        <hr>
                        <div class="alert alert-info small mb-0">
                            Hệ thống sẽ tự động xác nhận sau khi nhận được tiền.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- modal checkout-cod -->
        <div class="modal fade" id="codModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4 border-0 shadow">
                    <div class="modal-header border-bottom-0 pb-0">
                        <h5 class="modal-title fw-bold">Xác nhận đơn hàng (COD)</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted small mb-4">Vui lòng kiểm tra lại thông tin nhận hàng. Bạn có thể thay đổi nếu muốn giao đến địa chỉ khác.</p>
                        
                        <form id="form-checkout-cod">
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-uppercase">Số điện thoại liên hệ</label>
                                <input type="text" id="cod-phone" class="form-control rounded-3" 
                                    value="<%= user.phone || '' %>" required>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-uppercase">Địa chỉ giao hàng</label>
                                <textarea id="cod-address" class="form-control rounded-3" rows="3" required><%= user.address || '' %></textarea>
                            </div>
                            <div class="bg-light p-3 rounded-3 mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="small text-muted">Mã đơn hàng:</span>
                                    <span id="order-code" class="small fw-bold"></span>
                                </div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="small text-muted">Tổng tiền sản phẩm:</span>
                                    <span id="cod-temp" class="small fw-bold">0đ</span>
                                </div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="small text-muted">Phí vận chuyển:</span>
                                    <span id="cod-ship" class="small fw-bold">0đ</span>
                                </div>
                                <div class="d-flex justify-content-between border-top pt-2 mt-2">
                                    <span class="fw-bold">Tổng thanh toán:</span>
                                    <span id="cod-final" class="fw-bold text-success">0đ</span>
                                </div>
                            </div>

                            <button type="button" id="confirm-cod-btn" class="btn btn-dark w-100 rounded-pill py-2 fw-bold">
                                XÁC NHẬN ĐẶT HÀNG
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>


    <!-- sidebar toggle -->
    </div>
        <div id="mySidebar" class="sidebar">
            <div class="sidebar-header">
                <h3 class="text-white">AgriTrust</h3>
                <a href="javascript:void(0)" class="closebtn" id="closeSidebar">&times;</a>
        </div>
            
        <div class="sidebar-content">
            <a href="/"><i class="bi bi-house-door"></i> Trang chủ</a>
            <a href="/user/cart" class="active"><i class="bi bi-cart-fill"></i> Giỏ hàng</a>
            <a href="/user/cart/purchased_product"><i class="bi bi-truck"></i> Sản phẩm đang mua</a>
            <a href="/user/cart/history"><i class="bi bi-bag-check"></i> Sản phẩm đã mua</a>
            <hr class="text-secondary mx-3"> <a href="/user/cart/statistics"><i class="bi bi-graph-up"></i> Thống kê</a>
            <a href="/user/profile"><i class="bi bi-person-circle"></i> Profile</a>
        </div>
    </div>
    <div id="main">
    </div>

    <!-- đóng sidebar -->
    <div id="sidebarOverlay" class="sidebar-overlay"></div>

    <script>
        const bankConfig = {
            id: "<%= bankConfig.id %>",
            account: "<%= bankConfig.account %>",
            template: "<%= bankConfig.template %>",
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/updateCart.js"></script>
    <script src="/js/checkout.js"></script>
    <script src="/js/sidebar.js"></script>
    <script>
        updateFinalTotal()
    </script>
</body>
</html>