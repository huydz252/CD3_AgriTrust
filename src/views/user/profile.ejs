<!DOCTYPE html>
<html lang="vi">
<head>
    <%- include('../partials/head') %> 
    <title>Hồ sơ cá nhân | AgriTrust</title>
</head>
<body class="bg-light">
    <%- include('../partials/header') %>

    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-5">
                        <div class="text-center mb-4">
                            <img src="<%= user.avatar_url %>" class="rounded-circle shadow-sm mb-3" style="width: 120px; height: 120px; object-fit: cover;">
                            <h3 class="fw-bold"><%= user.display_name %></h3>
                            <span class="badge bg-success-subtle text-success rounded-pill px-3">
                                <%= user.role === 'admin' ? 'Quản trị viên' : 'Khách hàng' %>
                            </span>
                        </div>
                        <button class="btn btn-outline-success btn-sm rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                            <i class="bi bi-pencil-square me-2"></i>Chỉnh sửa hồ sơ
                        </button>

                        <hr class="my-4 opacity-25">
                        
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label class="text-muted small text-uppercase fw-bold">Email liên hệ</label>
                                <p class="fs-5"><%= user.email %></p>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small text-uppercase fw-bold">Ngày tham gia</label>
                                <p class="fs-5"><%= new Date(user.created_at).toLocaleDateString('vi-VN') %></p>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small text-uppercase fw-bold">Số điện thoại</label>
                                <p class="fs-5"><%= user.phone %></p>
                            </div>
                            <div class="col-md-6">
                                <label class="text-muted small text-uppercase fw-bold">Địa chỉ nhận hàng</label>
                                <p class="fs-5"><%= user.address%></p>
                            </div>
                            <div class="col-12">
                                <label class="text-muted small text-uppercase fw-bold">Ví Blockchain (MetaMask)</label>
                                <div class="d-flex align-items-center mt-2">
                                    <% if (user.wallet_address) { %>
                                        <code class="bg-light p-2 rounded flex-grow-1 text-primary"><%= user.wallet_address %></code>
                                        <a href="/user/remove-wallet">
                                            <button id="btn-unConnectMM" class="btn btn-dark btn-sm rounded-pill px-3">Ngắt kết nối!</button>
                                        </a>
                                        
                                    <% } else { %>
                                        <div class="alert alert-warning mb-0 w-100 d-flex justify-content-between align-items-center">
                                            <span>Chưa liên kết ví</span>
                                            <button id="btn-connectMM" class="btn btn-dark btn-sm rounded-pill px-3">Kết nối ngay</button>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>

                        <div class="mt-5 d-flex gap-2">
                            <a href="/api/products" class="btn btn-outline-secondary rounded-pill px-4">Quay lại cửa hàng</a>
                            <a href="/auth/logout" class="btn btn-danger rounded-pill px-4">Đăng xuất</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- modal update profile -->
     <div class="modal fade" id="editProfileModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow" style="border-radius: 20px;">
                <div class="modal-header border-0 pt-4 px-4">
                    <h5 class="modal-title fw-bold">Cập nhật hồ sơ</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="/user/profile/update" method="POST">
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase">Tên hiển thị</label>
                            <input type="text" name="display_name" class="form-control rounded-3" value="<%= user.display_name %>" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase">Số điện thoại</label>
                            <input type="tel" name="phone" class="form-control rounded-3" value="<%= user.phone || '' %>" placeholder="Nhập số điện thoại..." required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase">Địa chỉ giao hàng</label>
                            <textarea name="address" class="form-control rounded-3" rows="2" placeholder="Số nhà, tên đường, phường/xã..." required><%= user.address || '' %></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pb-4 px-4">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" id="btnUpdateProfile" class="btn btn-success rounded-pill px-4 shadow-sm">
                            Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- sidebar toggle -->
    </div>
        <div id="mySidebar" class="sidebar">
            <div class="sidebar-header">
                <h3 class="text-white">AgriTrust</h3>
                <a href="javascript:void(0)" class="closebtn" id="closeSidebar">&times;</a>
        </div>
            
        <div class="sidebar-content">
            <a href="/"><i class="bi bi-house-door"></i> Trang chủ</a>
            <a href="/user/cart" class="active"><i class="bi bi-cart-fill"></i> Giỏ hàng</a>
            <a href="/user/cart/purchased_product"><i class="bi bi-truck"></i> Sản phẩm đang mua</a>
            <a href="/user/cart/history"><i class="bi bi-bag-check"></i> Sản phẩm đã mua</a>
            <hr class="text-secondary mx-3"> <a href="/user/cart/statistics"><i class="bi bi-graph-up"></i> Thống kê</a>
            <a href="/user/profile"><i class="bi bi-person-circle"></i> Profile</a>
        </div>
    </div>
    <div id="main">
    </div>

    <!-- đóng sidebar -->
    <div id="sidebarOverlay" class="sidebar-overlay"></div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/ethers/6.7.0/ethers.umd.min.js"></script>
    <script src="/js/connectMetaMask.js"></script>
    <script src="/js/sidebar.js"></script>
</body>
</html>