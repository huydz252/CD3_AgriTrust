<!DOCTYPE html>
<html lang="vi">
<head>
    <%- include('../partials/head') %>
    <style>
        .order-card { border-radius: 15px; border: none; transition: 0.3s; }
        .order-card:hover { box-shadow: 0 5px 15px rgba(0,0,0,0.1); }
        .status-badge { padding: 5px 12px; border-radius: 50px; font-size: 0.8rem; }
    </style>
</head>
<body class="bg-light">
    <%- include('../partials/header') %>

    <div class="container py-5" id="main">
        <h2 class="fw-bold mb-4"><i class="bi bi-truck me-2"></i>Đơn hàng đang xử lý</h2>

        <% if (orders && orders.length > 0) { %>
            <div class="row">
                <% orders.forEach(order => { %>
                    <div class="col-12 mb-3">
                        <div class="card order-card shadow-sm p-3">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="fw-bold mb-1">Mã đơn: #<%= order.order_code %></h6>
                                    <small class="text-muted">Ngày đặt: <%= new Date(order.created_at).toLocaleString('vi-VN') %></small>
                                </div>
                                <div class="text-end">
                                    <span class="status-badge bg-warning text-dark">
                                        <i class="bi bi-clock"></i> <%= order.status === 'pending' ? 'Chờ xác nhận' : 'Đang giao' %>
                                    </span>
                                    <div class="fw-bold text-success mt-2">
                                        <%= Number(order.total_amount).toLocaleString('vi-VN') %>đ
                                    </div>
                                </div>
                            </div>
                            <hr>
                            <div class="d-flex justify-content-between">
                                <small>Phương thức: <strong><%= order.payment_method %></strong></small>
                                <a href="/user/cart/purchased_product/detail/<%= order.id %>" class="btn btn-sm btn-outline-success rounded-pill">Chi tiết</a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="text-center py-5">
                <img src="https://cdn-icons-png.flaticon.com/512/2038/2038854.png" style="width: 100px; opacity: 0.5;">
                <p class="mt-3 text-muted">Bạn không có đơn hàng nào đang chờ xử lý.</p>
                <a href="/" class="btn btn-success rounded-pill px-4">Mua sắm ngay</a>
            </div>
        <% } %>
    </div>

    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/sidebar.js"></script>
</body>
</html>