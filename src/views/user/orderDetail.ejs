<!DOCTYPE html>
<html lang="vi">
<head>
    <%- include('../partials/head') %>
    <style>
        .detail-card { border-radius: 15px; border: none; }
        .product-img-mini { width: 60px; height: 60px; object-fit: cover; border-radius: 8px; }
    </style>
</head>
<body class="bg-light">
    <%- include('../partials/header') %>
    <% 
        // Logic tính ngày
        let orderDate = new Date(order.created_at);
        orderDate.setDate(orderDate.getDate() + 4);
        let deliveryDate = orderDate.toLocaleDateString('vi-VN');

        // Logic dịch thuật
        const paymentMap = {
            'COD': 'Thanh toán khi nhận hàng (COD)',
            'QR': 'Thanh toán qua mã QR',
            'METAMASK': 'Thanh toán qua Ví MetaMask'
        };

        const statusMap = {
            'pending': { text: 'Chờ xác nhận', class: 'bg-warning text-dark' },
            'shipping': { text: 'Đang giao hàng', class: 'bg-primary' },
            'completed': { text: 'Đã hoàn thành', class: 'bg-success' },
            'cancelled': { text: 'Đã hủy', class: 'bg-danger' }
        };

        const currentPayment = paymentMap[order.payment_method] || order.payment_method;
        const currentStatus = statusMap[order.status] || { text: order.status, class: 'bg-secondary' };
    %>
    <div class="container py-5" id="main">
        <div class="d-flex align-items-center mb-4">
            <a href="/user/cart/purchased_product" class="btn btn-outline-secondary btn-sm rounded-pill me-3">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
            <h2 class="fw-bold mb-0">Chi tiết đơn hàng #<%= order.order_code %></h2>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card detail-card shadow-sm p-3 mb-3">
                    <h6 class="fw-bold text-success border-bottom pb-2">Thông tin nhận hàng</h6>
                    <p class="small mb-1"><strong>Người nhận:</strong> <%= user.display_name %></p>
                    <p class="small mb-1"><strong>Số điện thoại:</strong> <%= order.shipping_phone %></p>
                    <p class="small mb-0"><strong>Địa chỉ:</strong> <%= order.shipping_address %></p>
                    <p class="small mb-0"><strong>Ngày nhận hàng dự kiến:</strong> <%= deliveryDate %></p>
                </div>
                <div class="card detail-card shadow-sm p-3">
                    <h6 class="fw-bold text-success border-bottom pb-2">Thanh toán</h6>
                    <p class="small mb-1">
                        Hình thức: <strong><%= currentPayment %></strong> 
                    </p>
                    <p class="small mb-0">
                        Trạng thái: 
                        <span class="badge <%= currentStatus.class %>">
                            <%= currentStatus.text %>
                        </span>
                    </p>
                </div>
            </div>

            <div class="col-md-8">
                <div class="card detail-card shadow-sm p-4">
                    <table class="table align-middle">
                        <thead>
                            <tr class="text-muted small">
                                <th>Sản phẩm</th>
                                <th class="text-center">Số lượng</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% details.forEach(item => { %>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="<%= item.image_url %>" class="product-img-mini me-3" style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px;">
                                            <span class="fw-bold"><%= item.name %></span>
                                        </div>
                                    </td>
                                    <td class="text-center"><%= item.quantity %> kg</td>
                                    <td class="text-end fw-bold">
                                        <%= Number(item.total_price).toLocaleString('vi-VN') %>đ
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                        <tfoot class="border-top">
                            <tr>
                                <td colspan="2" class="text-end pt-3 text-muted">Tổng tiền hàng:</td>
                                <td class="text-end pt-3">
                                    <%= Number(subTotal).toLocaleString('vi-VN') %>đ
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2" class="text-end text-muted">Phí vận chuyển:</td>
                                <td class="text-end">
                                    <% if (shippingFee === 0) { %>
                                        <span class="text-success fw-bold">Miễn phí</span>
                                    <% } else { %>
                                        <%= Number(shippingFee).toLocaleString('vi-VN') %>đ
                                    <% } %>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2" class="text-end fw-bold fs-5 pt-2">Tổng thanh toán:</td>
                                <td class="text-end fw-bold fs-5 text-success pt-2">
                                    <%= Number(finalTotal).toLocaleString('vi-VN') %>đ
                                </td>
                            </tr>
                        </tfoot>
                    </table>    
                </div>
            </div>
        </div>
    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/sidebar.js"></script>
</body>
</html>