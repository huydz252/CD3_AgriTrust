<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Truy xuất nguồn gốc - #<%= product.id %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            
            <div class="card main-card mb-4">
                <div class="card-header-custom p-4 text-center">
                    <h2 class="fw-bold mb-1"><%= product.name %></h2>
                    <p class="mb-0 opacity-75">Mã lô hàng: #<%= product.id %></p>
                </div>
                <div class="card-body p-4">
                    <div class="row align-items-center">
                        <div class="col-md-9 border-end-md">
                            <div class="d-flex justify-content-center align-items-center gap-4">
                                <div class="text-center">
                                    <small class="text-muted d-block text-uppercase mb-1" style="font-size: 10px; letter-spacing: 1px;">Nguồn gốc</small>
                                    <div class="fw-bold text-dark"><i class="bi bi-geo-alt-fill text-danger"></i> <%= product.origin %></div>
                                </div>
                                <div class="vr opacity-25" style="height: 40px;"></div>
                                <div class="text-center">
                                    <small class="text-muted d-block text-uppercase mb-1" style="font-size: 10px; letter-spacing: 1px;">Trạng thái</small>
                                    <span class="badge <%= getStatusClass(product.currentStatus) %> px-3 py-2 rounded-pill shadow-sm">
                                        <%= getStatusName(product.currentStatus) %>
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 text-center text-md-end mt-3 mt-md-0">
                            <div class="d-inline-block bg-white p-2 rounded shadow-sm border">
                                <img src="<%= qrCode %>" alt="QR Code" style="width: 75px; height: 75px;">
                                <div style="font-size: 8px;" class="text-muted mt-1 text-uppercase fw-bold">Xác thực QR</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <% if (isAdmin) { %>
                <div class="text-center mb-4 no-print">
                    <button id="btnOpenModal" class="btn btn-primary rounded-pill px-4 shadow-sm" style="display: none;" data-bs-toggle="modal" data-bs-target="#modalUpdate">
                        <i class="bi bi-plus-circle"></i> Cập nhật giai đoạn mới
                    </button>
                </div>
            <% } %> 
            <div class="card main-card p-4">
                <h4 class="fw-bold mb-4 text-success"><i class="bi bi-shield-check"></i> Nhật ký Blockchain</h4>
                <div class="timeline">
                    <% if (list && list.length > 0) { %>
                        <% list.forEach(function(item) { %>
                            <div class="timeline-item">
                                <div class="timeline-dot"></div>
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <h5 class="fw-bold text-dark mb-1"><%= getStatusName(item.status) %></h5>
                                        <div class="small text-primary"><i class="bi bi-pin-map-fill"></i> <%= item.location %></div>
                                    </div>
                                    <small class="text-muted"><%= item.timestamp %></small>
                                </div>
                                
                                <div class="description-box shadow-sm">
                                    <i class="bi bi-info-circle me-1"></i> <%= item.description %>
                                </div>

                                <div class="tx-hash">
                                    <i class="bi bi-person-badge"></i> Xác thực: <%= item.performer %>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p class="text-center text-muted py-4">Chưa có dữ liệu lịch sử.</p>
                    <% } %>
                </div>
            </div>

            <div class="text-center mt-4 no-print">
                <a href="/api/products" class="btn btn-link text-secondary text-decoration-none small">Quay lại danh sách</a>
                <button class="btn btn-outline-dark btn-sm rounded-pill px-3 ms-2" onclick="window.print()">
                    <i class="bi bi-printer"></i> In báo cáo
                </button>
            </div>

        </div> </div>
</div>
<% if (isAdmin) { %>
<div class="modal fade" id="modalUpdate" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Cập nhật Stage</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" name="id" value="<%= product.id %>">
                <div class="mb-3">
                    <label class="form-label fw-bold">Trạng thái mới</label>
                    <select name="status" class="form-select">
                        <option value="1">🧺 Thu hoạch</option>
                        <option value="2">🚚 Vận chuyển</option>
                        <option value="3">📦 Sẵn sàng bán</option>
                        <option value="4">✅ Đã bán</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Địa điểm</label>
                    <input type="text" name="location" class="form-control" placeholder="Nhập vị trí...">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Ghi chú</label>
                    <textarea name="description" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" id="btnConfirmUpdate" class="btn btn-primary px-4" onclick="updateStageOnChain()">
                    Ký và Xác nhận
                </button>
            </div>
        </div>
    </div>
</div>
<% } %> 
<input type="hidden" id="adminAddr" value="<%= adminAddress %>">

<% 
function getStatusName(status) {
    const statuses = ["Đang trồng", "Đã thu hoạch", "Đang vận chuyển", "Sẵn sàng bán", "Đã bán"];
    return statuses[status] || "Không xác định";
}
function getStatusClass(status) {
    const classes = ["bg-info text-dark", "bg-warning text-dark", "bg-primary", "bg-success", "bg-dark"];
    return classes[status] || "bg-secondary";
}
%>

<script src="https://cdnjs.cloudflare.com/ajax/libs/ethers/6.7.0/ethers.umd.min.js"></script>

<script src="/js/web3-handler.js"></script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>