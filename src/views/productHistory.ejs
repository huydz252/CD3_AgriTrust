<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Truy xuất nguồn gốc - #<%= product.id %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { background-color: #f0f2f5; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .card-header-custom { background: linear-gradient(135deg, #27ae60 0%, #2ecc71 100%); color: white; border-radius: 15px 15px 0 0 !important; }
        .main-card { border: none; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.08); }
        
        /* Cấu trúc Timeline */
        .timeline { position: relative; padding: 20px 0; }
        .timeline::before { 
            content: ''; position: absolute; left: 20px; top: 0; width: 2px; height: 100%; 
            background: #e9ecef; border-left: 2px dashed #27ae60; 
        }
        .timeline-item { position: relative; margin-bottom: 40px; padding-left: 50px; }
        .timeline-dot { 
            position: absolute; left: 11px; top: 5px; width: 20px; height: 20px; 
            background: #27ae60; border-radius: 50%; border: 4px solid #fff; box-shadow: 0 0 0 3px #27ae60;
            z-index: 2;
        }
        .status-badge { font-size: 0.8rem; padding: 5px 12px; border-radius: 50px; }
        .tx-hash { font-family: 'Courier New', Courier, monospace; background: #f8f9fa; padding: 5px; border-radius: 5px; font-size: 11px; word-break: break-all; }
    </style>
</head>
<body>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            
            <div class="card main-card mb-4">
                <div class="card-header-custom p-4 text-center">
                    <h1 class="fw-bold mb-1"><%= product.name %></h1>
                    <p class="mb-0 opacity-75">Mã lô hàng: #<%= product.id %></p>
                </div>
                <div class="card-body p-4">
                    <div class="row text-center">
                        <div class="col-6 border-end">
                            <small class="text-muted d-block">Nguồn gốc</small>
                            <strong class="text-dark fs-5"><i class="bi bi-geo-alt-fill text-danger"></i> <%= product.origin %></strong>
                        </div>
                        <div class="col-6">
                            <small class="text-muted d-block">Trạng thái hiện tại</small>
                            <span class="badge <%= getStatusClass(product.currentStatus) %> fs-6">
                                <%= getStatusName(product.currentStatus) %>
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card main-card p-4">
                <h4 class="fw-bold mb-4"><i class="bi bi-shield-check text-success"></i> Nhật ký Blockchain</h4>
                
                <div class="timeline">
                    <% if (list && list.length > 0) { %>
                        <% list.forEach(function(item) { %>
                            <div class="timeline-item">
                                <div class="timeline-dot"></div>
                                <div class="d-flex justify-content-between">
                                    <h5 class="fw-bold text-success mb-1"><%= getStatusName(item.status) %></h5>
                                    <span class="text-muted small"><%= item.timestamp %></span>
                                </div>
                                <div class="mb-2">
                                    <i class="bi bi-pin-map-fill text-primary"></i> <strong>Địa điểm:</strong> <%= item.location %>
                                </div>
                                <div class="p-3 bg-light rounded border-start border-4 border-success mb-2">
                                    <i class="bi bi-info-circle"></i> <%= item.description %>
                                </div>
                                <div class="tx-hash text-muted">
                                    <i class="bi bi-person-badge"></i> Xác thực bởi (Performer): <br>
                                    <span class="text-dark"><%= item.performer %></span>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <p class="text-center text-muted">Chưa có dữ liệu lịch sử cho sản phẩm này.</p>
                    <% } %>
                </div>
            </div>

            <div class="text-center mt-4 no-print">
                <a href="/api/products" class="btn btn-secondary rounded-pill px-4 me-2">Quay lại danh sách</a>
                <button class="btn btn-outline-dark rounded-pill px-4" onclick="window.print()">
                    <i class="bi bi-printer"></i> In báo cáo
                </button>
            </div>

        </div>
    </div>
</div>

<% 
// Helper functions trực tiếp trong EJS
function getStatusName(status) {
    const statuses = ["Đang trồng", "Đã thu hoạch", "Đang vận chuyển", "Sẵn sàng bán", "Đã bán"];
    return statuses[status] || "Không xác định";
}

function getStatusClass(status) {
    const classes = ["bg-info text-dark", "bg-warning text-dark", "bg-primary", "bg-success", "bg-dark"];
    return classes[status] || "bg-secondary";
}
%>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>