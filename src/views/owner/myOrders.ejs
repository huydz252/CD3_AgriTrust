<!DOCTYPE html>
<html lang="vi">
<head>
    <%- include('../partials/head') %>
    <title>Đơn hàng của khách - AgriTrust</title>

    <style>
        .order-row { cursor: pointer; }
        .order-row:hover { background-color: #f8f9fa !important; }
        .product-list-container { background-color: #fafafa; }
        .product-item { border-left: 3px solid #198754; margin: 10px 20px; background: white; }
        .product-img-mini {
            width: 50px !important;  /* Cố định chiều rộng 50px */
            height: 50px !important; /* Cố định chiều cao 50px */
            object-fit: cover;       /* Quan trọng: Giúp ảnh không bị méo khi tỷ lệ khác nhau */
            border-radius: 8px;      /* Bo góc cho đẹp */
            border: 1px solid #dee2e6; /* Thêm viền nhẹ để tách biệt với nền */
        }
    </style>

</head>
<body class="bg-light">
    <%- include('../partials/header') %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-11">
            <h2 class="h3 mb-4 text-dark"><i class="bi bi-receipt-cutoff text-success me-2"></i>Quản lý đơn hàng</h2>

            <% if (orders && orders.length > 0) { %>
                <div class="card order-card shadow-sm">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Mã đơn hàng</th>
                                    <th>Khách hàng</th>
                                    <th>Tổng giá trị</th>
                                    <th>Ngày đặt</th>
                                    <th>Trạng thái</th>
                                    <th class="text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% orders.forEach((order, index) => { %>
                                    <!-- Dòng thông tin đơn hàng chính -->
                                    <tr class="order-row" data-bs-toggle="collapse" data-bs-target="#products-<%= index %>">
                                        <td class="ps-4">
                                            <span class="fw-bold text-primary"><%= order.order_code %></span>
                                            <small class="d-block text-muted"><%= order.products.length %> sản phẩm</small>
                                        </td>
                                        <td>
                                            <div class="fw-bold"><%= order.buyer_name %></div>
                                            <small class="text-muted"><%= order.buyer_email %></small>
                                        </td>
                                        <td><span class="text-success fw-bold"><%= order.totalAmount.toLocaleString('vi-VN') %> VNĐ</span></td>
                                        <td><%= new Date(order.created_at).toLocaleDateString('vi-VN') %></td>
                                        <td id="order_status_<%= index %>" class="text-center">
                                            <% if(order.isAllCompleted) { %>
                                                <!-- Trạng thái hoàn thành: Màu xanh lá, nền nhạt, có icon tích double -->
                                                <span class="badge rounded-pill bg-success-subtle text-success border border-success px-3 py-2">
                                                    <i class="bi bi-check-all me-1"></i> Đã hoàn thành
                                                </span>
                                            <% } else { %>
                                                <!-- Trạng thái chưa xong: Màu vàng/cam, nền nhạt, có icon đồng hồ cát -->
                                                <span class="badge rounded-pill bg-warning-subtle text-success border border-warning px-3 py-2">
                                                    <i class="bi bi-hourglass-split me-1"></i> Chưa hoàn thành
                                                </span>
                                            <% } %>
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-primary rounded-pill">
                                                <i class="bi bi-chevron-down me-1"></i> Xem chi tiết
                                            </button>
                                        </td>
                                    </tr>

                                    <!-- Dòng chứa danh sách sản phẩm (Xổ xuống) -->
                                    <tr class="collapse product-list-container" id="products-<%= index %>">
                                        <td colspan="5" class="p-0">
                                            <div class="py-3">
                                                <% order.products.forEach(p => { %>
                                        
                                                    <div class="product-item shadow-sm p-3 d-flex flex-row align-items-center justify-content-between rounded">                                                        <div class="d-flex align-items-center">
                                                        <img src="<%= p.image_url %>" class="product-img-mini me-3">
                                                        <div>
                                                            <div class="fw-bold"><%= p.product_name %></div>
                                                                <div class="text-muted" style="font-size: 0.85rem;">
                                                                    <!-- Hiển thị Số lượng x Đơn giá -->
                                                                    Số lượng: <span class="fw-bold text-dark"><%= p.quantity %></span> 
                                                                    <span class="mx-1">x</span> 
                                                                    <%= Number(p.price).toLocaleString('vi-VN') %> VNĐ = <%= (p.quantity * p.price).toLocaleString('vi-VN') %> VNĐ
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <div class="d-flex flex-column align-items-end gap-2">
                                                            <!-- ID này phải nằm ngoài button để không bị ghi đè innerHTML -->
                                                            <div id="status-container-<%= p.product_id %>">
                                                                <span class="badge <%= p.status === 'completed' ? 'bg-light text-success border border-success' : 'bg-success' %> px-3">
                                                                    <i class="bi <%= p.status === 'completed' ? 'bi-check-all' : 'bi-info-circle' %> me-1"></i>
                                                                    <%= getStatusName(p.status) %>
                                                                </span>
                                                            </div>

                                                            <% if (p.status !== 'completed' && p.status !== 'cancelled') { %>
                                                                <button class="btn btn-success btn-sm btn-update-status" 
                                                                        onclick="updateProductStatus('<%= p.order_id %>', '<%= p.product_id %>', '<%= p.status %>', event)">
                                                                    <i class="bi bi-arrow-right-circle me-1"></i>Xác nhận
                                                                </button>
                                                            <% } %>
                                                            
                                                            <a href="/api/history/<%= p.product_id %>" class="btn btn-sm btn-light border">
                                                                <i class="bi bi-eye"></i> Xem sản phẩm
                                                            </a>
                                                        </div>
                                                    </div>
                                                <% }) %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            <% } else { %>
                <div class="card border-0 shadow-sm py-5 text-center order-card">
                    <div class="card-body">
                        <i class="bi bi-inbox-fill text-muted" style="font-size: 4rem; opacity: 0.3;"></i>
                        <h4 class="mt-4 text-muted">Chưa có đơn hàng nào</h4>
                        <p class="text-secondary">Khi khách hàng đặt các nông sản của bạn, đơn hàng sẽ hiển thị tại đây.</p>
                        <a href="/owner/myProducts" class="btn btn-success mt-2">
                            <i class="bi bi-arrow-left me-2"></i>Quản lý kho hàng
                        </a>
                    </div>
                    </div>
            <% } %>
        </div>
    </div>
</div>

    <%
        function getStatusName(status) {
            const statuses = {
                "pending": "Xác nhận đơn hàng", 
                "confirmed": "Xác nhận xử lí", 
                "processing": "Xác nhận giao hàng", 
                "shipped": "Xác nhận đã giao", 
                "completed": "Đơn đã hoàn thành rồi!",
                "cancelled": "Đã hủy"
            };
            return statuses[status] || "Không xác định";
        }
    %>

    <%- include('../partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/ui/sidebar.js"></script>
    <script src="/js/owner/owner.js"></script>
</body>
</html>