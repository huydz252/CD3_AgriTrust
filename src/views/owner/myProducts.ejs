<!DOCTYPE html>
<html lang="vi">
<head>
    <%- include('../partials/head') %>
    <title>Sản phẩm của tôi - AgriTrust</title>
</head>
<body class="bg-light">
    <!-- Include Header & Sidebar (như Huy đã tách) -->
    <%- include('../partials/header') %>

    <div class="container-fluid py-4">
        <div class="row">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="h3 mb-0 text-gray-800">
                        <i class="bi bi-box-seam text-success me-2"></i>Sản phẩm bạn đang quản lý
                    </h2>
                    <span class="badge bg-success rounded-pill px-3 py-2">
                        Tổng cộng: <%= products.length %> sản phẩm
                    </span>
                </div>

                <div class="card shadow-sm border-0">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">ID</th>
                                        <th>Hình ảnh</th>
                                        <th>Tên sản phẩm</th>
                                        <th>Vị trí gốc</th>
                                        <th>Ngày tạo</th>
                                        <th class="text-center">Hành động</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (products.length > 0) { %>
                                        <% products.forEach(product => { %>
                                            <tr>
                                                <td class="ps-4"><span class="text-muted fw-bold">#<%= product.id %></span></td>
                                                <td>
                                                    <img src="<%= product.image_url || '/images/default-product.png' %>" 
                                                         alt="<%= product.name %>" 
                                                         class="rounded" 
                                                         style="width: 60px; height: 60px; object-fit: cover;">
                                                </td>
                                                <td>
                                                    <div class="fw-bold text-dark"><%= product.name %></div>
                                                    <small class="text-muted"><%= product.category || 'Nông sản' %></small>
                                                </td>
                                                <td>
                                                    <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                                                    <%= product.blockchainOrigin || product.origin %>
                                                    <% if (product.existsOnChain) { %>
                                                        <i class="bi bi-patch-check-fill text-primary" title="Đã xác minh trên Blockchain"></i>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <%= new Date(product.created_at).toLocaleDateString('vi-VN') %>
                                                </td>
                                                <td class="text-center">
                                                    <div class="btn-group shadow-sm">
                                                        <!-- Nút xem lịch sử (Timeline) -->
                                                        <a href="/api/history/<%= product.id %>" 
                                                           class="btn btn-outline-info btn-sm px-3"
                                                           title="Xem hành trình">
                                                            <i class="bi bi-clock-history"></i>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="6" class="text-center py-5 text-muted">
                                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                                Bạn chưa có sản phẩm nào do mình sở hữu.
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>